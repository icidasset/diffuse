{
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.15"
  },
  "tasks": {
    "astro": "astro",
    "astro:build": "astro build",
    "build": {
      "command": "deno task copy-types",
      "dependencies": ["astro:build"]
    },
    "copy-types": "deno run --allow-read --allow-write tasks/copy-types.ts",
    "deploy:netlify": "npx netlify deploy --prod",
    "dev": "astro dev"
  }
}
