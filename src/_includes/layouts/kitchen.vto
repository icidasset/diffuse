---
layout: layouts/diffuse.vto
base: ../
title: Diffuse

styles:
  - styles/base.css
  - styles/diffuse/page.css
  - styles/diffuse/code-editor.css
  - vendor/@phosphor-icons/bold/style.css
  - vendor/@phosphor-icons/fill/style.css

scripts:
  - common/pages/ppr.js
  - common/pages/version-upgrade.js
---

<style>
  .construct, h2 {
    color: var(--accent-twist-2);
  }
</style>

<header style="overflow: hidden">
  <div>
    <div class="diffuse-logo-container diffuse-logo-container--condensed">
      <a href="./" style="display: inline-block;">
        {{ await comp.diffuse.logo() }}
      </a>
    </div>
  </div>
  <div class="dither-mask filler filler--bg-twist-2">
    <div id="status--filler-container" style="color: var(--accent-twist-2)">
      {{ await comp.diffuse.status() }}
    </div>
  </div>
</header>

<main>
  {{ await comp.nav({ url, facets }) }}

  {{ content }}
</main>
