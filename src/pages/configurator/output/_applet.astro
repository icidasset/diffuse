<main class="container">
  <h1>Storage configuration</h1>
  <p>
    Here you can select where you want to keep your user data.
    <br />
    By default this will be your browser.
    <br />
    Click or tap on one to activate it.
  </p>
  <div id="options">
    <p>
      <span class="with-icon">
        <i class="iconoir-bonfire"></i>
        <small>Just a moment, loading storage options.</small>
      </span>
    </p>
  </div>
  <!-- Warning about cross sync -->
  <p>
    <small>
      <mark style="display: inline-block">
        <span class="with-icon">
          <i class="iconoir-warning-triangle"></i>
          Data is currently not synced across different storages!
        </span>
      </mark>
    </small>
  </p>
  <!-- Snapshots -->
  <h2>Export & Import</h2>
  <p>
    <a id="download" download="diffuse.json" style="cursor: pointer">Download a snapshot</a> of your
    data.
  </p>
</main>

<style is:global>
  iframe {
    display: none;
  }
</style>

<script>
  import { INITIAL_MANAGED_OUTPUT } from "@scripts/output/common";
  import { inIframe } from "@scripts/common";
  import { effect } from "spellcaster";

  import { connection } from "@scripts/configurator/output/connections";
  import { active } from "@scripts/configurator/output/signals";
  import { context } from "@scripts/configurator/output/context";
  import { setContextData } from "@scripts/configurator/output/events";

  ////////////////////////////////////////////
  // SETUP
  ////////////////////////////////////////////
  context.data = INITIAL_MANAGED_OUTPUT;

  ////////////////////////////////////////////
  // EFFECTS
  ////////////////////////////////////////////
  effect(() => {
    const method = active();

    // Monitor data
    (async () => {
      const conn = await connection(method);
      context.data = conn.data;
      conn.addEventListener("data", setContextData);
    })();
  });

  ////////////////////////////////////////////
  // ACTIONS
  ////////////////////////////////////////////
  const tracks = async (...args: unknown[]) => {
    const conn = await connection(active());
    await conn.sendAction("tracks", ...args, { timeoutDuration: 60000 * 5 });
  };

  context.setActionHandler("tracks", tracks);

  ////////////////////////////////////////////
  // UI
  ////////////////////////////////////////////
  const ui = inIframe() ? undefined : await import("@scripts/configurator/output/ui");
</script>
