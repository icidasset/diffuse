<main class="container">
  <h1>Input configuration</h1>
  <p>
    Here you can add your audio from various places.
    <br />Add audio from:
  </p>
  <div id="options">
    <p>
      <!-- TODO: Need to check if supported on this device -->
      <a href="../../input/native-fs/" class="with-icon">
        <i class="iconoir-open-in-window"></i>
        <strong>My device</strong>
      </a>
      <br />
      <a href="../../input/opensubsonic/" class="with-icon">
        <i class="iconoir-open-in-window"></i>
        <strong>Opensubsonic server</strong>
      </a>
      <br />
      <a href="../../input/s3/" class="with-icon">
        <i class="iconoir-open-in-window"></i>
        <strong>S3-compatible service</strong>
      </a>
    </p>
  </div>
</main>

<style is:global>
  iframe {
    display: none;
  }
</style>

<script>
  import type { Track } from "@applets/core/types";
  import type { Tasks } from "@scripts/configurator/input/worker";
  import { applet, register, tunnel } from "@scripts/applet/common";
  import { endpoint, transfer } from "@scripts/common";
  import manifest from "./_manifest.json";

  ////////////////////////////////////////////
  // SETUP
  ////////////////////////////////////////////
  const worker = endpoint<Tasks>(
    new Worker(new URL("../../../scripts/configurator/input/worker", import.meta.url), {
      type: "module",
      name: manifest.name,
    }),
  );

  // Register applet + worker
  const context = register({ worker });

  // Applet connections
  const input = {
    "file+local": applet("/input/native-fs", { context: self }),
    opensubsonic: applet("/input/opensubsonic", { context: self }),
    s3: applet("/input/s3", { context: self }),
  };

  // Provide tunnel to worker
  tunnel(worker, input);

  ////////////////////////////////////////////
  // ACTIONS
  ////////////////////////////////////////////
  const consult = async (fileUriOrScheme: string) => {
    return await worker.consult(fileUriOrScheme);
  };

  const contextualize = async (cachedTracks: Track[]) => {
    return await worker.contextualize(transfer(cachedTracks));
  };

  const groupConsult = async (tracks: Track[]) => {
    return await worker.groupConsult(transfer(tracks));
  };

  const list = async (cachedTracks: Track[] = []) => {
    return await worker.list(transfer(cachedTracks));
  };

  const resolve = async (args: { method: string; uri: string }) => {
    return await worker.resolve(args);
  };

  context.setActionHandler("consult", consult);
  context.setActionHandler("contextualize", contextualize);
  context.setActionHandler("groupConsult", groupConsult);
  context.setActionHandler("list", list);
  context.setActionHandler("resolve", resolve);
</script>
