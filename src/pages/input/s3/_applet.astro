<main class="container">
  <h1>S3-compatible input</h1>

  <h4>Mounted buckets</h4>

  <div id="buckets">
    <p>
      <span class="with-icon">
        <i class="iconoir-bonfire"></i>
        <small>Just a moment, loading mounted buckets.</small>
      </span>
    </p>
  </div>

  <h4>Add a new S3 bucket</h4>

  <form id="form"></form>

  <!-- Warning about hostnames/regions/buckets -->
  <!-- <p>
    <small>
      <span class="with-icon">
        <i class="iconoir-warning-triangle"></i>
        <span
          >The bucket name and region are not automatically prefixed/inserted into the hostname, you
          must add them yourself to either the host or the path <strong>if needed</strong>.</span
        >
      </span>
    </small>
  </p> -->
</main>

<style is:global>
  iframe {
    display: none;
  }
</style>

<script>
  import type { Track } from "@applets/core/types.d.ts";
  import type { Tasks } from "@scripts/input/s3/worker";
  import type { Bucket } from "@scripts/input/s3/types";
  import { register } from "@scripts/applet/common";
  import { endpoint, inIframe, transfer } from "@scripts/common";
  import manifest from "./_manifest.json";
  import { bucketId, loadBuckets, saveBuckets } from "@scripts/input/s3/common";

  ////////////////////////////////////////////
  // SETUP
  ////////////////////////////////////////////
  const worker = endpoint<Tasks>(
    new Worker(new URL("../../../scripts/input/s3/worker", import.meta.url), {
      type: "module",
      name: manifest.name,
    }),
  );

  // Register applet
  const context = register({ worker });

  ////////////////////////////////////////////
  // ACTIONS
  ////////////////////////////////////////////
  const consult = async (fileUriOrScheme: string) => {
    return await worker.consult(fileUriOrScheme);
  };

  const contextualize = async (tracks: Track[]) => {
    const s = await worker.contextualize(transfer(tracks));
    ui?.setBuckets({ ...ui?.buckets(), ...s });
  };

  const groupConsult = async (tracks: Track[]) => {
    return await worker.groupConsult(transfer(tracks));
  };

  const list = async (cachedTracks: Track[] = []) => {
    return await worker.list(transfer(cachedTracks));
  };

  const resolve = async (args: { method: string; uri: string }) => {
    return await worker.resolve(args);
  };

  const mount = async (bucket: Bucket) => {
    // NOTE: This may, or may not, be a good idea.
    const buckets = await loadBuckets();
    const id = bucketId(bucket);

    if (!buckets[id]) {
      await saveBuckets({ ...buckets, [bucketId(bucket)]: bucket });
    }
  };

  const unmount = async () => {};

  context.setActionHandler("consult", consult);
  context.setActionHandler("contextualize", contextualize);
  context.setActionHandler("groupConsult", groupConsult);
  context.setActionHandler("list", list);
  context.setActionHandler("resolve", resolve);
  context.setActionHandler("mount", mount);
  context.setActionHandler("unmount", unmount);

  ////////////////////////////////////////////
  // UI
  ////////////////////////////////////////////
  const ui = inIframe() ? undefined : await import("@scripts/input/s3/ui");
</script>
