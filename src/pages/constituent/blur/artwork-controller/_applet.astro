---
import "@styles/reset.css";
import "@styles/variables.css";
import "@styles/fonts.css";
import "@styles/animations.css";
import "@styles/icons/phosphor.css";

import "@styles/diffuse/colors.css";
import "@styles/diffuse/fonts.css";
---

<main>
  <section class="artwork"></section>

  <section class="controller">
    <div class="gradient-blur">
      <div></div>
      <div></div>
      <div></div>
      <div></div>
      <div></div>
      <div></div>
      <div></div>
      <div></div>
    </div>

    <div class="controller__background"></div>

    <!-- Content -->
    <section class="controller__inner"></section>
  </section>
</main>

<style>
  :root {
    --transition-durition: 500ms;
  }

  main {
    background: var(--color-3);
    color: white;
    display: flex;
    flex-direction: column;
    font-size: var(--fs-sm);
    height: 100dvh;
    /* max-width: var(--container-xs); */
    overflow: hidden;
    position: relative;
    transition:
      background-color var(--transition-durition),
      color var(--transition-durition);
  }

  /* Artwork */

  .artwork {
    flex: 1;
    position: relative;
  }

  .artwork img {
    height: 100%;
    left: 0;
    object-fit: cover;
    opacity: 0;
    position: absolute;
    top: 0;
    transition-duration: var(--transition-durition);
    transition-property: opacity;
    width: 100%;
    z-index: 0;
  }

  .artwork label {
    background: oklch(0 0 0);
    border-radius: var(--radius-sm);
    box-shadow: var(--box-shadow-lg);
    font-size: var(--fs-2xs);
    font-weight: 600;
    left: var(--space-xs);
    letter-spacing: var(--tracking-wide);
    line-height: 1;
    padding: 7px 6px 6px;
    position: absolute;
    text-transform: uppercase;
    top: var(--space-xs);
    transition:
      background-color var(--transition-durition),
      color var(--transition-durition);
    z-index: 10;
  }

  /* Progress bars */

  progress {
    appearance: none;
    border: 0;
    display: block;
    height: 4px;
    width: 100%;
  }

  progress,
  progress::-webkit-progress-bar {
    background-color: color-mix(in oklch, currentColor 40%, transparent);
    overflow: hidden;
    border-radius: 4px;
  }

  progress[value]::-webkit-progress-value {
    border-radius: 4px;
    background-color: color-mix(in oklch, currentColor 90%, transparent);
  }

  progress[value]::-moz-progress-bar {
    border-radius: 4px;
    background-color: color-mix(in oklch, currentColor 50%, transparent);
  }

  /* Controller */

  .controller {
    flex-shrink: 0;
    padding: 0 var(--space-md) var(--space-md);
    position: relative;
  }

  .controller__background {
    inset: 0;
    opacity: 0.5;
    position: absolute;
    transition: background-color var(--transition-durition);
    z-index: 1;
  }

  .controller__inner {
    position: relative;
    transition-duration: var(--transition-durition);
    transition-property: color;
    z-index: 10;
  }

  .controller__inner.controller__inner--light-mode {
    color: rgba(0, 0, 0, 0.6);
  }

  /* Now playing */

  cite {
    display: block;
    font-style: normal;
    text-shadow: var(--text-shadow-sm);
  }

  .controller__inner--light-mode cite {
    text-shadow: none;
  }

  /* Progress */

  .progress {
    cursor: pointer;
    margin: var(--space-xs) 0;
    padding-top: var(--space-2xs);
  }

  .timestamps {
    display: flex;
    font-size: var(--fs-2xs);
    font-weight: 500;
    justify-content: space-between;
    margin-top: var(--space-3xs);
    opacity: 0.4;
    text-shadow: var(--text-shadow-xs);
  }

  .controller__inner--light-mode .timestamps {
    text-shadow: none;
  }

  /* Controls */

  .controller menu {
    align-items: center;
    display: flex;
    font-size: var(--fs-lg);
    gap: var(--space-lg);
    justify-content: center;
    margin: var(--space-md) 0;
    padding: 0;
    text-align: center;
  }

  .controller .menu__loader {
    line-height: 0;
    transform-origin: center;
  }

  .controller command {
    cursor: pointer;
    line-height: 0;
    transition-duration: var(--transition-durition);
    transition-property: opacity;
  }

  .controller .ph-pause,
  .controller .ph-play,
  .controller .menu__loader {
    font-size: var(--fs-xl);
  }

  /* Volume */

  footer {
    align-items: center;
    display: flex;
    font-size: var(--fs-xs);
    gap: var(--space-2xs);
    justify-content: space-between;
  }

  footer .progress-bar {
    cursor: pointer;
    flex: 1;
    padding: var(--space-2xs) 0;
  }

  footer i {
    cursor: pointer;
  }

  /* Gradient blur */

  .gradient-blur {
    bottom: 0;
    height: 150%;
    left: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    z-index: 2;
  }

  .gradient-blur > div {
    position: absolute;
    inset: 0;
  }

  .gradient-blur > div:nth-of-type(1) {
    backdrop-filter: blur(1px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 4.166666665%,
      rgba(0, 0, 0, 1) 8.333333332%,
      rgba(0, 0, 0, 0) 12.499999999%
    );
    z-index: 1;
  }

  .gradient-blur > div:nth-of-type(2) {
    backdrop-filter: blur(2px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 4.166666665%,
      rgba(0, 0, 0, 1) 8.333333332%,
      rgba(0, 0, 0, 1) 12.499999999%,
      rgba(0, 0, 0, 0) 16.666666666%
    );
    z-index: 2;
  }

  .gradient-blur > div:nth-of-type(3) {
    backdrop-filter: blur(4px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 8.333333332%,
      rgba(0, 0, 0, 1) 12.499999999%,
      rgba(0, 0, 0, 1) 16.666666666%,
      rgba(0, 0, 0, 0) 20.833333333%
    );
    z-index: 3;
  }

  .gradient-blur > div:nth-of-type(4) {
    backdrop-filter: blur(8px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 12.499999999%,
      rgba(0, 0, 0, 1) 16.666666666%,
      rgba(0, 0, 0, 1) 20.833333333%,
      rgba(0, 0, 0, 0) 25%
    );
    z-index: 4;
  }

  .gradient-blur > div:nth-of-type(5) {
    backdrop-filter: blur(16px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 16.666666666%,
      rgba(0, 0, 0, 1) 20.833333333%,
      rgba(0, 0, 0, 1) 25%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 5;
  }

  .gradient-blur > div:nth-of-type(6) {
    backdrop-filter: blur(32px);
    mask: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 20.833333333%,
      rgba(0, 0, 0, 1) 25%,
      rgba(0, 0, 0, 1) 100%
    );
    z-index: 6;
  }

  .gradient-blur > div:nth-of-type(7) {
    backdrop-filter: blur(64px);
    mask: linear-gradient(to bottom, rgba(0, 0, 0, 0) 25%, rgba(0, 0, 0, 1) 100%);
    z-index: 7;
  }
</style>

<style is:global>
  iframe {
    display: none;
  }
</style>

<script>
  import scope from "astro:scope";
  import { FastAverageColor } from "fast-average-color";
  import { Temporal } from "@js-temporal/polyfill";
  import { xxh32r } from "xxh32/dist/raw.js";

  import { computed, effect, signal } from "@scripts/spellcaster";
  import { tags, text, type ElementConfigurator } from "@scripts/spellcaster/hyperscript.js";

  import type { Track } from "@applets/core/types";
  import { applet, hs, inputUrl, reactive, register } from "@scripts/applet/common";
  import { trackArtworkCacheId } from "@scripts/common";

  ////////////////////////////////////////////
  // SETUP
  ////////////////////////////////////////////
  import type * as AudioEngine from "@applets/engine/audio/types.d.ts";
  import type * as QueueEngine from "@applets/engine/queue/types.d.ts";

  import type { Artwork } from "@applets/processor/artwork/types";
  import { debounce } from "throttle-debounce";

  // Register
  const context = register();

  // Signals
  const activeTrack = signal<Track | undefined>(undefined);
  const artwork = signal<Artwork[]>([]);
  const artworkColor = signal<string | undefined>(undefined);
  const artworkLightMode = signal<boolean>(false);
  const duration = signal<string>("0:00");
  const isLoading = signal<boolean>(true);
  const isPlaying = signal<boolean>(false);
  const progress = signal<number>(0);
  const time = signal<string>("0:00");
  const volume = signal<number>(0);

  // Is main group
  function isMainGroup() {
    return context.groupId === undefined || context.groupId.toLowerCase() === "main";
  }

  // Applet connections
  const configurator = {
    input: applet("/configurator/input"),
  };

  const engine = {
    audio: await applet<AudioEngine.State>("/engine/audio", { groupId: context.groupId }),
    queue: await applet<QueueEngine.State>("/engine/queue", { groupId: context.groupId }),
  };

  const orchestrator = {
    queueAudio: applet("/orchestrator/queue-audio", { groupId: context.groupId }),
    queueTracks: isMainGroup()
      ? applet("/orchestrator/queue-tracks", { groupId: context.groupId })
      : undefined,
    processTracks: isMainGroup() ? applet("/orchestrator/process-tracks") : undefined,
  };

  const processor = {
    artwork: applet("/processor/artwork"),
  };

  ////////////////////////////////////////////
  // ✨ EFFECTS
  // ⌚️ Time
  ////////////////////////////////////////////
  const formatTimestamps = () => {
    const prog = progress();
    const curr = engine.queue.data.now;
    const audio = curr ? engine.audio.data.items[curr.id] : undefined;
    const dur = curr?.stats?.duration ?? audio?.duration;

    if (audio && dur != undefined && !isNaN(dur)) {
      const p = Temporal.Duration.from({
        milliseconds: Math.round(dur * prog * 1000),
      }).round({
        largestUnit: "hours",
      });

      const d = Temporal.Duration.from({ milliseconds: Math.round(dur * 1000) }).round({
        largestUnit: "hours",
      });

      time(formatTime(p));
      duration(formatTime(d));
    } else {
      time("0:00");
      duration("0:00");
    }
  };

  effect(formatTimestamps);

  function formatTime(duration: Temporal.Duration) {
    return `${duration.hours > 0 ? duration.hours.toFixed(0) + ":" : ""}${duration.hours > 0 ? (duration.minutes > 9 ? duration.minutes.toFixed(0) : "0" + duration.minutes.toFixed(0)) : duration.minutes.toFixed(0)}:${duration.seconds > 9 ? duration.seconds.toFixed(0) : "0" + duration.seconds.toFixed(0)}`;
  }

  ////////////////////////////////////////////
  // ✨ EFFECTS
  // ⏳️ Loading
  ////////////////////////////////////////////

  const debouncedSetIsLoading = debounce(2000, isLoading);

  ////////////////////////////////////////////
  // 🔊 AUDIO
  ////////////////////////////////////////////

  reactive(
    engine.audio,
    (data) => data.items[engine.queue.data.now?.id ?? Infinity]?.loadingState === "loaded",
    (isLoaded) => debouncedSetIsLoading(!isLoaded),
  );

  reactive(
    engine.audio,
    (data) =>
      data.isPlaying && (data.items[engine.queue.data.now?.id ?? Infinity]?.isPlaying ?? false),
    (i) => isPlaying(i),
  );

  reactive(
    engine.audio,
    (data) => data.items[engine.queue.data.now?.id ?? Infinity]?.progress ?? 0,
    (p) => progress(p),
  );

  reactive(
    engine.audio,
    (data) => data.volume.default,
    (v) => volume(v),
  );

  ////////////////////////////////////////////
  // 🎢 QUEUE
  ////////////////////////////////////////////

  // Set active track based on active queue item.

  reactive(
    engine.queue,
    (data) => data.now,
    (track) => {
      activeTrack(track || undefined);
      progress(0);
    },
  );

  // Changed artwork based on active queue item.
  // (debounced)

  reactive(engine.queue, (data) => data.now, debounce(1000, changeArtwork));

  async function changeArtwork() {
    const track = engine.queue.data.now;

    if (!track) {
      artwork([]);
      return;
    }

    const input = await configurator.input;
    const cacheId = await trackArtworkCacheId(track);
    const urls = {
      get: await inputUrl(input, track.uri, "GET").then((a) => a?.url),
      head: await inputUrl(input, track.uri, "HEAD").then((a) => a?.url),
    };

    const proc = await processor.artwork;
    const art = await proc.sendAction(
      "artwork",
      {
        cacheId,
        tags: track.tags,
        urls,
      },
      {
        timeoutDuration: 60000 * 5,
        worker: true,
      },
    );

    const currTrack = activeTrack();
    const currCacheId = currTrack ? await trackArtworkCacheId(currTrack) : undefined;
    if (cacheId === currCacheId) artwork(art);
  }

  ////////////////////////////////////////////
  // UI
  ////////////////////////////////////////////
  const bg = document.body.querySelector<HTMLElement>(".controller__background");
  const controller = document.body.querySelector<HTMLElement>(".controller__inner");
  const main = document.body.querySelector("main");
  const showcase = document.body.querySelector<HTMLElement>(".artwork");

  if (!bg || !controller || !main || !showcase) throw new Error("Missing DOM elements");

  const h = (
    tag: string,
    props?: Record<string, any> | (() => Record<string, any>),
    configure?: ElementConfigurator,
  ) => hs(tag, scope, props, configure);

  ////////////////////////////////////////////
  // UI ░ ARTWORK
  ////////////////////////////////////////////

  const timeouts: Record<string, ReturnType<typeof setTimeout>> = {};

  effect(() => {
    const art = artwork();

    // No artwork, fade out existing.
    if (art.length === 0) {
      showcase.querySelectorAll("img").forEach((node) => {
        node.style.opacity = "0";
        const hash = node.getAttribute("data-hash");
        if (hash) timeouts[hash] = setTimeout(() => node.remove(), 1000);
      });
      return;
    }

    // Determine if the current artwork needs to be replaced.
    const hash = xxh32r(art[0].bytes).toString();
    const existingArtwork = showcase.querySelector<HTMLImageElement>(`img[data-hash="${hash}"]`);

    // If the artwork is the same, stop here.
    if (existingArtwork) {
      const timeoutId = timeouts[hash];
      if (timeoutId) clearTimeout(timeoutId);
      existingArtwork.style.opacity = "1";
      return;
    }

    // Add new artwork
    const blob = new Blob([art[0].bytes.buffer as ArrayBuffer], { type: art[0].mime });
    const url = URL.createObjectURL(blob);

    // Create img for new artwork
    const img = h("img", {
      src: url,
      className: "artwork",
      attrs: {
        "data-hash": hash,
      },
    });

    // Extract average color
    img.onload = () => {
      const fac = new FastAverageColor();
      const color = fac.getColor(img as HTMLImageElement);
      const rgb = color.value;
      const o = Math.round((rgb[0] * 299 + rgb[1] * 587 + rgb[2] * 114) / 1000);

      artworkColor(color.rgba);
      artworkLightMode(o > 165);
      bg.style.backgroundColor = color.rgba;
      main.style.backgroundColor = color.rgba;
      img.style.opacity = "1";

      showcase.querySelectorAll("img").forEach((node) => {
        if (node === img) return;
        node.style.opacity = "0";
        timeouts[hash] = setTimeout(() => node.remove(), 1000);
      });
    };

    // Insert new artwork
    showcase.appendChild(img);
  });

  effect(() => {
    if (artworkLightMode()) controller.classList.add("controller__inner--light-mode");
    else controller.classList.remove("controller__inner--light-mode");
  });

  ////////////////////////////////////////////
  // UI ░ GROUP ID
  ////////////////////////////////////////////

  const GroupId = h(
    "label",
    computed(() => {
      const display = isMainGroup() ? "none" : "block";

      return {
        attrs: {
          style: `background: ${artworkColor()}; display: ${display};`,
        },
      };
    }),
    text(context.groupId),
  );

  showcase.appendChild(GroupId);

  ////////////////////////////////////////////
  // UI ░ NOW PLAYING
  ////////////////////////////////////////////

  const NowPlaying = h("cite", {}, [
    h("strong", {}, text(computed(() => activeTrack()?.tags?.title || "Diffuse"))),
    tags.br(),
    h(
      "span",
      computed(() => {
        return {
          style: isMainGroup() && !activeTrack() ? "font-style: italic" : "",
        };
      }),
      text(
        computed(
          () =>
            activeTrack()?.tags?.artist ||
            (isMainGroup() && !activeTrack() ? "Waiting on queue ..." : ""),
        ),
      ),
    ),
  ]);

  controller.appendChild(NowPlaying);

  ////////////////////////////////////////////
  // UI ░ PROGRESS
  ////////////////////////////////////////////

  const ProgressBar = h(
    "progress",
    computed(() => ({ max: "100", value: `${progress() * 100}` })),
    [],
  );

  const Time = h("div", { className: "timestamps" }, [
    h(
      "time",
      computed(() => {
        return { attrs: { datetime: time() } };
      }),
      text(time),
    ),
    h(
      "time",
      computed(() => {
        return { attrs: { datetime: duration() } };
      }),
      text(duration),
    ),
  ]);

  const Progress = h("div", { className: "progress", onclick: seek }, [ProgressBar, Time]);

  function seek(event: MouseEvent) {
    const percentage = event.offsetX / (event.target as HTMLProgressElement).clientWidth;
    engine.audio.sendAction("seek", { audioId: engine.queue.data.now?.id, percentage });
  }

  controller.appendChild(Progress);

  ////////////////////////////////////////////
  // UI ░ CONTROLS
  ////////////////////////////////////////////

  const Control = (
    label: string,
    icon: string,
    props: Record<string, any> | (() => Record<string, any>),
  ) => {
    return h("command", props, [h("i", { className: icon, title: label })]);
  };

  const Controls = h("menu", {}, [
    Control("Previous track", "ph-fill ph-rewind", { onclick: previous }),
    h(
      "div",
      computed(() => {
        const style = `display: ${activeTrack() && isLoading() ? "inherit" : "none"}`;
        return { className: "animate-bounce menu__loader", style };
      }),
      [h("i", { className: "ph-fill ph-vinyl-record", title: "Loading ..." })],
    ),
    Control(
      "Play",
      "ph-fill ph-play",
      computed(() => {
        const style = `display: ${(!isPlaying() && !isLoading()) || !activeTrack() ? "inline" : "none"}`;
        return { onclick: playPause, style };
      }),
    ),
    Control(
      "Pause",
      "ph-fill ph-pause",
      computed(() => {
        const style = `display: ${isPlaying() && !isLoading() ? "inline" : "none"}`;
        return { onclick: playPause, style };
      }),
    ),
    Control("Next track", "ph-fill ph-fast-forward", { onclick: next }),
  ]);

  function playPause() {
    const audioId = engine.queue.data.now?.id;

    if (isPlaying() && audioId) {
      engine.audio.sendAction("pause", { audioId });
    } else if (audioId) {
      engine.audio.sendAction("play", { audioId });
    }
  }

  function previous() {
    engine.queue.sendAction("unshift", { groupId: context.groupId }, { worker: true });
  }

  function next() {
    engine.queue.sendAction("shift", { groupId: context.groupId }, { worker: true });
  }

  controller.appendChild(Controls);

  ////////////////////////////////////////////
  // UI ░ VOLUME
  ////////////////////////////////////////////

  const VolumeBar = h(
    "div",
    {
      className: "progress-bar",
      onclick: volumeClickHandler,
    },
    [
      h(
        "progress",
        computed(() => ({
          max: "100",
          value: (volume() * 100).toString(),
        })),
      ),
    ],
  );

  const Volume = h("footer", {}, [
    h("i", { className: "ph-fill ph-speaker-none", onclick: mute }),
    VolumeBar,
    h("i", { className: "ph-fill ph-speaker-high", onclick: fullVolume }),
  ]);

  function volumeClickHandler(event: MouseEvent) {
    const percentage = event.offsetX / (event.target as HTMLProgressElement).clientWidth;
    engine.audio.sendAction("volume", { volume: percentage });
  }

  function fullVolume() {
    engine.audio.sendAction("volume", { volume: 1 });
  }

  function mute() {
    engine.audio.sendAction("volume", { volume: 0 });
  }

  controller.appendChild(Volume);
</script>
