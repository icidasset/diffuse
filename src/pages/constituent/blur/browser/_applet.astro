---
import "@styles/reset.css";
import "@styles/variables.css";
import "@styles/fonts.css";
import "@styles/animations.css";
import "@styles/icons/phosphor.css";

import "@styles/diffuse/colors.css";
import "@styles/diffuse/fonts.css";
---

<main>
  <search>
    <form>
      <input type="search" placeholder="Search" />
    </form>
  </search>

  <blur-list> </blur-list>
</main>

<!-- STYLE -->

<style>
  main {
    background: white;
    color: var(--color-3);
    display: flex;
    flex-direction: column;
    font-size: var(--fs-sm);
    height: 100dvh;
    overflow: hidden;
    position: relative;
    transition:
      background-color var(--transition-durition),
      color var(--transition-durition);
  }

  /* SEARCH */

  search {
    & input {
      display: block;
      width: 100%;
    }
  }

  /* LIST */

  blur-list {
    display: block;
    flex: 1;
    overflow: hidden;

    & ul {
      height: 100%;
      overflow-y: scroll;
    }

    & ul li {
      content-visibility: auto;
      contain-intrinsic-size: auto 21px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>

<style is:global>
  iframe {
    display: none;
  }
</style>

<script>
  import astroScope from "astro:scope";
  import { effect, signal } from "alien-signals";
  import { liftAlien } from "@lift-html/alien";

  import { applet, reactive, register } from "@scripts/applet/common";
  import type { ManagedOutput, Track } from "@applets/core/types";

  ////////////////////////////////////////////
  // SETUP
  ////////////////////////////////////////////
  import type * as Search from "@applets/processor/search/types.d.ts";

  // Register
  const context = register();

  // Signals
  const $searchTerm = signal<string>("");
  const $tracks = signal<Track[]>([]);

  // Is main group
  function isMainGroup() {
    return context.groupId === undefined || context.groupId.toLowerCase() === "main";
  }

  // Applet connections
  const orchestrator = {
    // processTracks: isMainGroup() ? applet("/orchestrator/process-tracks") : undefined,
    searchTracks: isMainGroup()
      ? applet("/orchestrator/search-tracks", { groupId: context.groupId })
      : undefined,
  };

  const processor = {
    search: applet<Search.State>("/processor/search"),
  };

  ////////////////////////////////////////////
  // ✨ EFFECTS
  ////////////////////////////////////////////

  processor.search.then((search) => {
    reactive(
      search,
      (data) => data.cacheId,
      async () => {
        console.log("Search cache id:", search.data.cacheId);
        const tracks = await search.sendAction("search", $searchTerm().trim(), { worker: true });
        $tracks(tracks);
      },
    );
  });

  ////////////////////////////////////////////
  // UI
  ////////////////////////////////////////////
  const html = (strings: string[] | ArrayLike<string>, ...values: any[]) =>
    String.raw({ raw: strings }, ...values);
  const scope = `data-astro-cid-${astroScope}`;

  ////////////////////////////////////////////
  // UI ░ LIST
  ////////////////////////////////////////////

  liftAlien("blur-list", {
    observedAttributes: ["item-height"],

    async init() {
      // const props = useAttributes(this);

      effect(() => {
        this.innerHTML = html`
          <ul ${scope}>
            ${$tracks()
              .slice(0, 100)
              .map((track: Track) => {
                return html`<li ${scope}>${track.tags?.artist} - ${track.tags?.title}</li>`;
              })
              .join("")}
          </ul>
        `;
      });
    },
  });
</script>
