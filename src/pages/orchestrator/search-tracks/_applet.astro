<script>
  import type { GroupConsult, ManagedOutput, Track } from "@applets/core/types.d.ts";
  import { applet, reactive, register, wait } from "@scripts/applet/common";

  ////////////////////////////////////////////
  // SETUP
  ////////////////////////////////////////////
  const context = register();

  // Applet connections
  const configurator = {
    input: applet("/configurator/input"),
    output: applet<ManagedOutput>("/configurator/output"),
  };

  const processor = {
    search: applet("/processor/search"),
  };

  ////////////////////////////////////////////
  // SEARCH ⭤ TRACKS
  ////////////////////////////////////////////
  async function monitorTracks() {
    await context.settled();

    // Add tracks to the search supply once the tracks have been loaded;
    // and every time the collection changes.

    const input = await configurator.input;
    const output = await configurator.output;
    const search = await processor.search;

    await wait(output, (d) => d?.tracks.state === "loaded");

    reactive(
      output,
      (data) => data.tracks.cacheId,
      async () => {
        if (!context.isMainInstance()) return;

        const groups = await input.sendAction<GroupConsult>(
          "groupConsult",
          output.data.tracks.collection,
          { timeoutDuration: 60000 * 5, worker: true },
        );

        // Available tracks
        let tracks: Track[] = [];

        Object.values(groups).forEach((value) => {
          if (value.available === false) return;
          tracks = tracks.concat(value.tracks);
        }, []);

        // Supply
        await search.sendAction("supply", tracks, {
          timeoutDuration: 60000,
          worker: true,
        });
      },
    );
  }

  ////////////////////////////////////////////
  // 🚀
  ////////////////////////////////////////////
  monitorTracks();
</script>
