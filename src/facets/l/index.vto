---
layout: layouts/facet.vto
base: ../../

styles:
  - styles/vendor/phosphor/fill/style.css
  - styles/base.css
  - styles/loader.css

scripts:
  - facets/l/index.js
---

<div id="container">
  <div class="diffuse">
    <div id="diffuse-loader" class="flex">
      <i class="ph-fill ph-music-notes animate-bounce"></i>
    </div>
  </div>
</div>

<script type="importmap">
  {
    "imports": {
      "@diffuse/foundation": "./common/facets/foundation.js",

      "@diffuse/common/": "./common/",
      "@diffuse/components/": "./components/",
      "@diffuse/definitions/": "./definitions/",
      "@diffuse/styles/": "./styles/",
      "@diffuse/themes/": "./themes/",

      "@atcute/tid": "./vendor/@atcute/tid/index.js"
    }
  }
</script>
