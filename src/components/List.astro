---
const { items } = Astro.props;
---

<ul>
  {
    items.map((item: { title: string; url: string }) => (
      <li>
        {item.title.startsWith("(TODO) ") ? (
          <span>{item.title}</span>
        ) : (
          <a href={item.url}>{item.title}</a>
        )}
      </li>
    ))
  }
</ul>
