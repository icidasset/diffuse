---
layout: layouts/diffuse.vto
base: ../../

styles:
  - themes/webamp/fonts.css
  - themes/webamp/index.css
---

<!--

###################################
# UI
###################################

-->
<main>
  <!-- 🪟 -->
  <section class="windows">
    <style>
    dtw-window-manager > * {
      left: 12px;
      position: absolute;
      top: 12px;
      z-index: 999;

      /* Waiting on https://developer.mozilla.org/en-US/docs/Web/CSS/sibling-index#browser_compatibility */
      &:nth-child(1) {
        left: 24px;
        top: 24px;
      }

      &:nth-child(2) {
        left: 36px;
        top: 36px;
      }

      &:nth-child(3) {
        left: 48px;
        top: 48px;
      }

      &:nth-child(4) {
        left: 60px;
        top: 60px;
      }

      &:nth-child(5) {
        left: 72px;
        top: 72px;
      }

      &:nth-child(6) {
        left: 84px;
        top: 84px;
      }

      &:nth-child(7) {
        left: 96px;
        top: 96px;
      }

      &:nth-child(8) {
        left: 108px;
        top: 108px;
      }

      &:nth-child(9) {
        left: 120px;
        top: 120px;
      }
    }
    </style>

    <dtw-window-manager>
      <!-- INPUT -->
      <dtw-window id="input-window">
        <span slot="title-icon"><img src="images/icons/windows_98/cd_audio_cd_a-0.png" height="14" /></span>
        <span slot="title">Manage audio inputs</span>

        <dtw-input-config
          input-selector="#input"
          output-selector="#output"
          sources-orchestrator-selector="do-sources"
          process-tracks-orchestrator-selector="do-process-tracks"
        ></dtw-input-config>

      </dtw-window>

      <!-- OUTPUT -->
      <dtw-window id="output-window">
        <span slot="title-icon"><img src="images/icons/windows_98/computer_user_pencil-0.png" height="14" /></span>
        <span slot="title">Manage user data</span>

        <dtw-output-config></dtw-output-config>
      </dtw-window>

      <!-- BROWSER -->
      <dtw-window id="browser-window" window-style="height: 380px; width: 560px;">
        <span slot="title-icon"><img src="images/icons/windows_98/directory_explorer-4.png" height="14" /></span>
        <span slot="title">Browse collection</span>

        <dtw-browser
          input-selector="#input"
          output-selector="#output"
          queue-engine-selector="de-queue"
          search-processor-selector="dp-search"
        ></dtw-browser>
      </dtw-window>
    </dtw-window-manager>
  </section>

  <!-- 🛋️ -->
  <section class="desktop">
    <!-- WINAMP -->
    <a class="button desktop__item" id="desktop-winamp">
      <img src="images/icons/windows_98/winamp2-32x32.png" height="32" />
      <label>Winamp</label>
    </a>

    <!-- INPUT -->
    <a class="button desktop__item">
      <img src="images/icons/windows_98/cd_audio_cd_a-4.png" height="32" />
      <label for="input-window">Manage audio inputs</label>
    </a>

    <!-- OUTPUT -->
    <a class="button desktop__item">
      <img src="images/icons/windows_98/computer_user_pencil-0.png" height="32" />
      <label for="output-window">Manage user data</label>
    </a>

    <!-- BROWSE -->
    <a class="button desktop__item">
      <img src="images/icons/windows_98/directory_explorer-5.png" height="32" />
      <label for="browser-window">Browse collection</label>
    </a>

    <!-- INSERT -->
    <a class="button desktop__item" id="desktop-batch">
      <img src="images/icons/windows_98/multimedia-4.png" height="32" />
      <label>Add shuffled batch</label>
    </a>
  </section>

  <!-- ⚡️ -->
  <dtw-webamp></dtw-webamp>
</main>

<!--

###################################
# COMPONENTS
###################################

-->
<de-queue></de-queue>

<!-- Processors -->
<dp-metadata></dp-metadata>
<dp-search></dp-search>

<!-- Orchestrators -->
<do-input id="input"></do-input>
<do-output id="output"></do-output>

<do-process-tracks
  input-selector="#input"
  metadata-processor-selector="dp-metadata"
  output-selector="#output"

  process-when-ready
></do-process-tracks>

<do-scoped-tracks
  input-selector="#input"
  output-selector="#output"
  search-processor-selector="dp-search"
></do-scoped-tracks>

<do-sources
  input-selector="#input"
  output-selector="#output"
></do-sources>

<!--

SCRIPTS

-->
<script src="themes/webamp/index.js" type="module"></script>
