{{ set colorClass = (path) => url === "/" + path ? '' : 'button--transparent' }}
{{ set slug = (cat) => cat.toLowerCase().replace(/\s+/g, '-') }}

<div class="nav-container">
  <nav id="diffuse-nav">
    <a href="dashboard/" class="button {{ colorClass("dashboard/") }} button--border">
      <span class="with-icon">
        <i class="ph-fill ph-person"></i>
        Your Diffuse
      </span>
    </a>

    <a href="guide/" class="button {{ colorClass("guide/") }} button--border">
      <span class="with-icon">
        <i class="ph-fill ph-book-open-text"></i>
        Guide
      </span>
    </a>

    <a href="featured/" class="button {{ colorClass("featured/") }} button--border">
      <span class="with-icon">
        <i class="ph-fill ph-sparkle"></i>
        Featured
      </span>
    </a>

    <a href="catalogue/" class="button {{ colorClass("catalogue/") }} button--border">
      <span class="with-icon">
        <i class="ph-fill ph-storefront"></i>
        Catalogue
      </span>
    </a>

    <a href="code/" class="button {{ colorClass("code/") }} button--border">
      <span class="with-icon">
        <i class="ph-fill ph-hammer"></i>
        Code
      </span>
    </a>
  </nav>

  <button
    id="nav-overflow-btn"
    class="button button--transparent button--border"
    style="display: none; flex-shrink: 0"
    popovertarget="nav-overflow-menu"
  >
    <span class="with-icon">
      <i class="ph-fill ph-dots-three-outline"></i>
    </span>
  </button>

  <div id="nav-overflow-menu" class="dropdown" popover></div>
</div>
