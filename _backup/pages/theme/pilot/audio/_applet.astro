---
import "@styles/reset.css";
import "@styles/variables.css";
import "@styles/fonts.css";
import "@styles/icons/iconoir.css";
import "@styles/theme/pilot/variables.css";
---

<main>
  <div class="queue-entry"></div>
  <div class="playback-info">
    <div class="controls">
      <button class="controls__playpause">
        <i class="iconoir-play-solid"></i>
      </button>
    </div>
    <div class="time">
      <progress max="100" value="0"></progress>
    </div>
  </div>
  <div class="additional"></div>
</main>

<style>
  main {
    align-items: center;
    background: var(--made-in-the-shade);
    color: oklch(from var(--made-in-the-shade) calc(l + 0.375) c h);
    display: flex;
    justify-content: center;
    text-align: center;
  }

  button {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: inline-block;
    line-height: 0;
  }

  /***********************************
   * Playback info
   ***********************************/
  .playback-info {
    align-items: center;
    display: flex;
    flex: 1;
    flex-direction: column;
    max-width: var(--container-lg);
    margin-top: var(--space-2xs);
    padding: var(--space-2xs) var(--space-md);
  }

  .controls {
    align-items: center;
    display: flex;
    justify-content: center;

    & .controls__playpause {
      font-size: var(--fs-lg);
    }
  }

  .time {
    align-self: stretch;
    display: flex;
    padding: var(--space-2xs) 0;
  }

  progress {
    appearance: none;
    border: 0;
    flex: 1;
    height: 4px;
  }

  progress::-webkit-progress-bar {
    background-color: oklch(from var(--made-in-the-shade) calc(l + 0.15) c h);
    overflow: hidden;
    border-radius: 4px;
  }

  progress::-webkit-progress-value {
    background-color: oklch(from var(--made-in-the-shade) calc(l + 0.3) c h);
    border-radius: 4px;
  }

  progress::-moz-progress-bar {
  }
</style>

<script>
  // @ts-ignore
  import scope from "astro:scope";

  import type { State } from "./types.d.ts";
  import { register } from "@scripts/applet/common";

  ////////////////////////////////////////////
  // SETUP
  ////////////////////////////////////////////
  const context = register<State>();

  // Initial state
  context.data = {
    isPlaying: false,
  };

  ////////////////////////////////////////////
  // ACTIONS
  ////////////////////////////////////////////
  context.setActionHandler("modifyIsPlaying", (isPlaying: boolean) => {
    // NOTE: Doesn't trigger a `data` event
    context.data.isPlaying = isPlaying;
    render();
  });

  context.setActionHandler("modifyProgress", (progress: number) => {
    const p = isNaN(progress) || !isFinite(progress) ? 0 : Math.min(Math.max(progress, 0), 1);
    const el = document.body.querySelector("progress");
    if (el) el.value = p * 100;
  });

  ////////////////////////////////////////////
  // UI
  ////////////////////////////////////////////
  document.body.querySelector(".controls__playpause")?.addEventListener("click", () => {
    context.data = { ...context.data, isPlaying: !(context.data?.isPlaying ?? false) };
  });

  document.body.querySelector(".time")?.addEventListener("click", (event: Event) => {
    const mouseEvent = event as MouseEvent;
    const seekPosition = mouseEvent.offsetX / (event.target as HTMLProgressElement).clientWidth;
    context.data = { ...context.data, seekPosition };
  });

  function render() {
    const button = document.body.querySelector("button");

    if (button)
      button.innerHTML = context.data.isPlaying
        ? `<i class="iconoir-pause-solid" data-astro-cid-${scope}></i>`
        : `<i class="iconoir-play-solid" data-astro-cid-${scope}></i>`;
  }
</script>
