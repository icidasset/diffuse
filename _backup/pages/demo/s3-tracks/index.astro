---
import Page from "../../../layouts/page.astro";
import "@styles/pico.scss";
---

<Page title="Diffuse">
  <main class="container">
    <h1>Add sample S3 bucket to inputs</h1>

    <p>
      Clicking the button below will add some sample music, which you can then play using the
      various <a href="/#themes" target="_blank">themes, abstractions and constituents</a>.

      <br />
      <br />

      <button>Add sample content</button>
    </p>
  </main>

  <style is:global>
    iframe {
      display: none;
    }
  </style>

  <script>
    import { applet } from "@scripts/applet/common";
    import type { Bucket } from "@scripts/input/s3/types";

    document.querySelector("button")?.addEventListener("click", clickHandler);

    async function clickHandler() {
      const p = document.body.querySelector("p");
      const s3 = await applet("/input/s3");

      // Credentials are read-only, no worries.
      const bucket: Bucket = {
        accessKey: atob("QUtJQTZPUTNFVk1BWFZDRFFINkI="),
        bucketName: "ongaku-ryoho-demo",
        host: "s3.amazonaws.com",
        path: "/",
        region: "us-east-1",
        secretKey: atob("Z0hPQkdHRzU1aXc0a0RDbjdjWlRJYTVTUDRZWnpERkRzQnFCYWI4Mg=="),
      };

      await s3.sendAction("mount", bucket, { timeoutDuration: 60000 });

      // Finished
      if (p)
        p.innerHTML = `
          Content added! Try it out using the <a href="/constituent/blur/artwork-controller/" target="_blank">blur artwork controller</a> or any other <a href="/#themes" target="_blank">theme, abstraction or constituent</a>.
        `;

      // Additionally process inputs automatically
      applet("/orchestrator/process-tracks");
    }
  </script>
</Page>
