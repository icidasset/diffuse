---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <style>
      @import "../styles/reset.css";
      @import "../styles/fonts.css";
      @import "../styles/variables.css";
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
