---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="manifest" href="manifest.json" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
